@model ShoeStore.Models.ProductCardViewModel
@{
  const string ImageRevision = "20260913-3xl-reframe";
  string VersionedImageUrl(string imageUrl) => $"{imageUrl}{(imageUrl.Contains('?') ? '&' : '?')}v={ImageRevision}";
  string ProductThumbnail(string imageUrl) => imageUrl.StartsWith("/images/products/", StringComparison.OrdinalIgnoreCase)
    && !imageUrl.EndsWith("yeezy-foam-runner.jpg", StringComparison.OrdinalIgnoreCase)
      ? $"/images/products/thumbs/{System.IO.Path.GetFileNameWithoutExtension(imageUrl)}.webp"
      : imageUrl;
  var variants=Model.Variants.OrderByDescending(v=>v.IsDefault).ToList();
  var selected=variants.FirstOrDefault();
  var image=selected is null ? "" : selected.ThumbnailUrl is not null && !string.Equals(selected.ThumbnailUrl, selected.ImageUrl, StringComparison.OrdinalIgnoreCase)
    ? selected.ThumbnailUrl
    : ProductThumbnail(selected.ImageUrl);
  var versionedImage=VersionedImageUrl(image);
}
<article class="product" data-product-card>
 <a aria-disabled="true" tabindex="-1"><div class="image-wrap">@if(Model.IsNew){<span class="tag">NEW</span>}<img src="@versionedImage" alt="@Model.BrandName @Model.Name" data-variant-image loading="lazy" decoding="async" /></div><p class="brand">@Model.BrandName</p><h3>@Model.Name</h3><p class="color" data-variant-label>@(selected?.Name ?? "—")</p><strong>@Model.Price.ToString("N0") ₽</strong></a>
 @if(variants.Count>1){<div class="variant-picker" aria-label="Расцветки @Model.BrandName @Model.Name">@foreach(var variant in variants){<button type="button" class="color-swatch @(variant.IsDefault?"is-selected":"")" style="--swatch:@variant.Swatch" title="@variant.Name" aria-label="@variant.Name" aria-pressed="@(variant.IsDefault?"true":"false")" data-variant-choice data-variant-name="@variant.Name" data-variant-image-url="@VersionedImageUrl(variant.ThumbnailUrl ?? variant.ImageUrl)"></button>}</div>}
</article>
