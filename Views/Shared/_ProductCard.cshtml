@model ShoeStore.Models.ProductCardViewModel
@{
  var selected = Model.Variants.FirstOrDefault(variant => variant.IsDefault) ?? Model.Variants.FirstOrDefault();
  var image = selected?.ThumbnailUrl;
  if (string.IsNullOrWhiteSpace(image)) image = selected?.ImageUrl;
  if (string.IsNullOrWhiteSpace(image)) image = Model.ImageUrl;
  var hasImage = !string.IsNullOrWhiteSpace(image);
}

<article class="product" data-product-card>
  <a class="product-card__link" asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" aria-label="Открыть @Model.BrandName @Model.Name">
  <div class="image-wrap">
    <img src="@(hasImage ? image : null)" asp-append-version="true" alt="@Model.BrandName @Model.Name" data-variant-image loading="lazy" decoding="async" hidden="@(!hasImage)" />
    <span class="product-image-empty" data-variant-image-empty hidden="@hasImage">Нет фотографии</span>
    @if (ViewData["ShowProductBadges"] is true)
    {
      <div class="product-badges">
        @if (Model.IsNew)
        {
          <span class="product-badge product-badge--new" data-product-badge="new" aria-label="Новинка">NEW</span>
        }
        @if (Model.IsPopular)
        {
          <span class="product-badge product-badge--popular" data-product-badge="popular" aria-label="Хит">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M12 2 14.5 9.5 22 12 14.5 14.5 12 22 9.5 14.5 2 12 9.5 9.5Z" />
            </svg>
          </span>
        }
      </div>
    }
  </div>
  <p class="brand">@Model.BrandName</p>
  <h3>@Model.Name</h3>
  @if (selected is not null)
  {
    <p class="color" data-variant-label>@selected.Name</p>
  }
  <strong>@Model.Price.ToString("N0") ₽</strong>
  </a>
  @if (Model.Variants.Count > 1)
  {
    <div class="variant-picker" role="group" aria-label="Расцветки @Model.BrandName @Model.Name">
      @foreach (var variant in Model.Variants)
      {
        var active = variant.Id == selected?.Id;
        <button type="button" class="color-swatch @(active ? "is-selected" : "")" style="--swatch:@variant.Swatch"
                title="@variant.Name" aria-label="@variant.Name" aria-pressed="@(active ? "true" : "false")"
                data-variant-choice data-variant-id="@variant.Id" data-variant-name="@variant.Name"
                data-variant-image-url="@(string.IsNullOrWhiteSpace(variant.ThumbnailUrl) ? variant.ImageUrl : variant.ThumbnailUrl)"></button>
      }
    </div>
  }
</article>
