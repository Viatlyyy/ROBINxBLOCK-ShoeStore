@model string
<svg class="account-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  @switch (Model)
  {
    case "home":
      <path d="M3 10.5 12 3l9 7.5V21h-6v-7H9v7H3z" />
      break;
    case "profile":
      <circle cx="12" cy="7" r="4" /><path d="M4 21v-2a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v2z" />
      break;
    case "orders":
      <path d="M12 2 3 7v10l9 5 9-5V7zM3 7l9 5 9-5M12 12v10M7.5 4.5l9 5" />
      break;
    case "heart":
      <path d="M20.8 4.9a5 5 0 0 0-7.1 0L12 6.6l-1.7-1.7a5 5 0 0 0-7.1 7.1l8.8 8.8 8.8-8.8a5 5 0 0 0 0-7.1Z" />
      break;
    case "logout":
      <path d="M10 4H4v16h6m-1-8h12m-4-4 4 4-4 4" />
      break;
    case "arrow":
      <path d="M3 12h17m-6-6 6 6-6 6" />
      break;
    case "back":
      <path d="M21 12H4m6-6-6 6 6 6" />
      break;
    case "chevron":
      <path d="m9 5 7 7-7 7" />
      break;
    case "check":
      <path d="m4 12 5 5L20 6" />
      break;
    case "close":
      <circle cx="12" cy="12" r="9" /><path d="m9 9 6 6m0-6-6 6" />
      break;
    case "truck":
      <path d="M2 6h12v11H2zm12 4h4l4 4v3h-8M2 17h2m5 0h7m5 0h1" />
      <circle cx="6.5" cy="18" r="2" fill="white" /><circle cx="18.5" cy="18" r="2" fill="white" />
      break;
    case "cart":
      <path d="M3 4h2l2 12h12l2-9H6m3 13h.01m8 0h.01" />
      <circle cx="9" cy="20" r=".8" /><circle cx="17" cy="20" r=".8" />
      break;
    case "pencil":
      <path d="M4 16.5 16.5 4a2.1 2.1 0 0 1 3 3L7 19.5 3 21zm10-10 3 3" />
      break;
    case "photo":
      <rect x="3" y="4" width="18" height="16" rx="2" /><circle cx="9" cy="9" r="1.5" /><path d="m4 18 5-5 3 3 4-5 4 5" />
      break;
  }
</svg>
