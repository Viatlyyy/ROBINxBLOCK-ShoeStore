@model ShoeStore.Models.AccountOrderDetails
@using System.Globalization
@{
  Layout = "_CabinetLayout";
  ViewData["Title"] = $"Заказ №{Model.Order.Number}";
  var culture = CultureInfo.GetCultureInfo("ru-RU");
  var payment = Model.PaymentMethod switch
  {
    "cash" => "При получении",
    "card" => "Банковская карта",
    "apple" => "Apple Pay",
    "google" => "Google Pay",
    _ => Model.PaymentMethod
  };
}
<div class="account-order-meta">
  <time datetime="@Model.Order.CreatedAt.ToString("O")">от @Model.Order.CreatedAt.ToLocalTime().ToString("d MMMM yyyy", culture)</time>
  <partial name="_OrderStatus" model="Model.Order.Status" />
  <a class="account-text-link" asp-action="Orders"><partial name="_AccountIcon" model='"back"' /> Все заказы</a>
</div>
<div class="account-detail-grid">
  <section class="account-panel account-order-items" aria-labelledby="order-items-title">
    <h2 id="order-items-title">Состав заказа</h2>
    @if (Model.Lines.Count == 0)
    {
      <p class="account-muted">Позиции этого заказа недоступны.</p>
    }
    else
    {
      <ul>
        @foreach (var line in Model.Lines)
        {
          <li>
            <partial name="_OrderImage" model="line.ImageUrl" />
            <div class="account-order-items__product">
              <strong>@line.Name</strong>
              @if (!string.IsNullOrWhiteSpace(line.VariantName)) { <span>@line.VariantName</span> }
              <span>Размер @line.Size EU</span>
              <span>Количество: @line.Quantity</span>
              @if (line.Quantity > 1) { <span>За пару: @line.Price.ToString("N0", culture) ₽</span> }
            </div>
            <strong class="account-order-items__price">@((line.Price * line.Quantity).ToString("N0", culture)) ₽</strong>
          </li>
        }
      </ul>
    }
  </section>
  <section class="account-panel account-order-summary" aria-labelledby="order-summary-title">
    <h2 id="order-summary-title">Доставка и оплата</h2>
    <dl>
      <dt>Получение</dt>
      <dd>
        @(string.IsNullOrWhiteSpace(Model.DeliveryMethod) ? "Не указано" : Model.DeliveryMethod)
        @if (Model.DeliveryMethod != "Самовывоз" && !string.IsNullOrWhiteSpace(Model.Address)) { <span>@Model.Address</span> }
      </dd>
      <dt>Оплата</dt>
      <dd>@(string.IsNullOrWhiteSpace(payment) ? "Не указана" : payment)</dd>
    </dl>
    <div class="account-order-summary__total">
      <span>Итого</span>
      <strong>@Model.Order.Total.ToString("N0", culture) ₽</strong>
    </div>
  </section>
</div>
