@inject ShoeStore.Services.AvatarStore Avatars
@{
  var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
  var isCabinet = controller.Equals("Cabinet", StringComparison.OrdinalIgnoreCase);
  var hasProductCards = isCabinet || controller.Equals("Home", StringComparison.OrdinalIgnoreCase)
    || controller.Equals("Catalog", StringComparison.OrdinalIgnoreCase)
    || controller.Equals("Cart", StringComparison.OrdinalIgnoreCase);
  var isCart = controller.Equals("Cart", StringComparison.OrdinalIgnoreCase);
  var isHome = controller.Equals("Home", StringComparison.OrdinalIgnoreCase)
    && action.Equals("Index", StringComparison.OrdinalIgnoreCase);
  var isProductDetails = controller.Equals("Catalog", StringComparison.OrdinalIgnoreCase)
    && action.Equals("Details", StringComparison.OrdinalIgnoreCase);
  var isCartIndex = isCart && action.Equals("Index", StringComparison.OrdinalIgnoreCase);
  var isOrderPage = isCart && (action.Equals("Checkout", StringComparison.OrdinalIgnoreCase)
    || action.Equals("Success", StringComparison.OrdinalIgnoreCase));
  var isCatalog = controller.Equals("Catalog", StringComparison.OrdinalIgnoreCase)
    && action.Equals("Index", StringComparison.OrdinalIgnoreCase);
  var cartCount = ShoeStore.Services.CartService.GetCount(Context.Session, initialize: isProductDetails);
  // Дополнительные стили и переключатель пароля нужны только на страницах входа и регистрации.
  var isAccountEntry = controller.Equals("Account", StringComparison.OrdinalIgnoreCase)
    && (action.Equals("Login", StringComparison.OrdinalIgnoreCase) || action.Equals("Register", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] — RONINxBLOCK</title>
  <link rel="preload" href="~/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  @if (isHome)
  {
    <link rel="preload" as="image" href="/images/hero/9060-urban-feet-v6-960.webp" imagesrcset="/images/hero/9060-urban-feet-v6-960.webp 960w, /images/hero/9060-urban-feet-v6-1600.webp 1600w" imagesizes="100vw" fetchpriority="high" />
  }
  <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/storefront.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/placeholders.css" asp-append-version="true" />
  @if (isHome)
  {
    <link rel="stylesheet" href="~/css/brand-ticker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/feature-tiles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/culture-board.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hero-light.css" asp-append-version="true" />
  }
  @if (isHome || isCatalog || isCabinet)
  {
    <link rel="stylesheet" href="~/css/product-cards.css" asp-append-version="true" />
  }
  @if (isCatalog)
  {
    <link rel="stylesheet" href="~/css/catalog-controls.css" asp-append-version="true" />
  }
  @if (isProductDetails)
  {
    <link rel="stylesheet" href="~/css/product-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/product-gallery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/quantity-picker.css" asp-append-version="true" />
  }
  <link rel="stylesheet" href="~/css/account-menu.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/cart-fly.css" asp-append-version="true" />
  @if (isCartIndex)
  {
    <link rel="stylesheet" href="~/css/product-cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/cart-reference.css" asp-append-version="true" />
  }
  @if (isHome || isCatalog || isCartIndex || isProductDetails || isCabinet)
  {
    <link rel="stylesheet" href="~/css/variants.css" asp-append-version="true" />
  }
  @if (isOrderPage) { <link rel="stylesheet" href="~/css/checkout-reference.css" asp-append-version="true" /> }
  @if (isAccountEntry) { <link rel="stylesheet" href="~/css/account-reference.css" asp-append-version="true" /> }
  <link rel="stylesheet" href="~/css/page-intro.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/performance.css" asp-append-version="true" />
  @if (hasProductCards) { <link rel="stylesheet" href="~/css/favorites.css" asp-append-version="true" /> }
  @if (isCabinet)
  {
    <link rel="stylesheet" href="~/css/customer-account.css" asp-append-version="true" />
    <link rel="expect" href="#account-content" blocking="render" />
    <script src="~/js/customer-account-motion.js" asp-append-version="true" data-cabinet-root="@Url.Action("Index", "Cabinet")"></script>
  }
</head>
<body class="storefront-shell @(isCabinet ? "customer-account-page" : null)">
  @if (!isCabinet) { <script src="~/js/page-intro.js" asp-append-version="true"></script> }
  <header class="header">
    <a class="logo" asp-controller="Home" asp-action="Index">RONIN<span>xBLOCK</span></a>
    <nav aria-label="Основная навигация">
      <a asp-controller="Catalog" asp-action="Index">Каталог</a>
      <a asp-controller="Catalog" asp-action="Index" asp-route-tag="new">Новинки</a>
      <a asp-controller="Catalog" asp-action="Index" asp-route-tag="popular">Хиты</a>
    </nav>
    <div class="header-actions">
      <a class="header-icon-button" asp-controller="Cart" asp-action="Index" aria-label="Корзина" title="Корзина">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 4.5h2l1.6 10.1h10.3l2-7.3H6.2M8 19a1.2 1.2 0 1 0 0 2.4A1.2 1.2 0 0 0 8 19Zm8.2 0a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z" /></svg>
        <span class="header-cart-count @(cartCount>0?"is-visible":"")" data-cart-count>@cartCount</span>
      </a>
      @if (User.Identity?.IsAuthenticated == true)
      {
        // Имя пришло из claim при регистрации. Для аккаунтов без имени используем запасной вариант.
        var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
        displayName = string.IsNullOrWhiteSpace(displayName) ? "Пользователь" : displayName.Trim();
        var avatarLetter = System.Globalization.StringInfo.GetNextTextElement(displayName).ToUpperInvariant();
        <div class="account-menu" data-account-menu>
          <button class="account-menu__trigger" type="button" aria-label="Открыть меню аккаунта" aria-haspopup="true" aria-expanded="false" data-account-menu-trigger>
            @if (await Avatars.HasCurrentAvatarAsync(Context.RequestAborted))
            {
              <img src="@Url.Action("Avatar", "Cabinet")" alt="" width="32" height="32" />
            }
            else { @avatarLetter }
          </button>
          <div class="account-menu__panel" role="menu" aria-label="Меню аккаунта" data-account-menu-panel>
            <p class="account-menu__email">@displayName</p>
            <a asp-controller="Cabinet" asp-action="Index" role="menuitem">Личный кабинет</a>
            @* Form Tag Helper добавит токен для POST-выхода; ссылка GET сессию не завершает. *@
            <form asp-controller="Account" asp-action="Logout" method="post">
              <button type="submit" role="menuitem">Выйти</button>
            </form>
          </div>
        </div>
      }
      else
      {
        <a asp-controller="Account" asp-action="Login">Войти</a>
      }
    </div>
  </header>
  <main>
    @if (TempData["FavoriteNotice"] is string favoriteNotice)
    {
      <p class="favorite-message" role="alert">@favoriteNotice</p>
    }
    @RenderBody()
  </main>
  @if (hasProductCards)
  {
    <p class="sr-only" role="status" data-favorite-announcement></p>
    <p class="favorite-feedback is-error" role="alert" data-favorite-error hidden></p>
  }
  <footer class="store-footer" id="contacts">
    <div class="store-footer__grid">
      <div><a class="logo" asp-controller="Home" asp-action="Index">RONIN<span>xBLOCK</span></a></div>
      <nav aria-label="Навигация в футере">
        <h2>Магазин</h2>
        <a asp-controller="Catalog" asp-action="Index">Каталог</a>
        <a asp-controller="Catalog" asp-action="Index" asp-route-tag="new">Новинки</a>
        <a asp-controller="Catalog" asp-action="Index" asp-route-tag="popular">Хиты</a>
        <a asp-controller="Cabinet" asp-action="Index">Личный кабинет</a>
      </nav>
      <div>
        <h2>Контакты</h2>
        <a class="store-footer__phone" href="tel:+79180566359">8 (918) 056-63-59</a>
        <address>Новороссийск, ул. Толстого, 2/4<br />Парк имени М. В. Фрунзе</address>
        <a class="store-footer__website" href="https://vk.ru/public216238112" target="_blank" rel="noopener noreferrer">ВКонтакте ↗</a>
      </div>
    </div>
    <div class="store-footer__bottom"><span>© @DateTime.Now.Year RONINxBLOCK</span></div>
  </footer>
  @if (User.Identity?.IsAuthenticated == true) { <script src="~/js/account-menu.js" asp-append-version="true"></script> }
  @if (isAccountEntry) { <script src="~/js/account-form.js" asp-append-version="true"></script> }
  <script src="~/js/smooth-scroll.js" asp-append-version="true"></script>
  @if (isHome)
  {
    <script src="~/js/hero-carousel.js" asp-append-version="true"></script>
    <script src="~/js/feature-reveal.js" asp-append-version="true"></script>
    <script src="~/js/brand-ticker.js" asp-append-version="true"></script>
  }
  @if (hasProductCards) { <script src="~/js/product-photos.js" asp-append-version="true"></script> }
  @if (isHome || isCatalog || isCartIndex || isProductDetails || isCabinet)
  {
    <script src="~/js/product-colors.js" asp-append-version="true" defer></script>
  }
  @if (isProductDetails)
  {
    <script src="~/js/product-gallery.js" asp-append-version="true"></script>
    <script src="~/js/product-options.js" asp-append-version="true"></script>
    <script src="~/js/cart-fly.js" asp-append-version="true"></script>
  }
  @if (isCartIndex) { <script src="~/js/cart-quantity.js" asp-append-version="true"></script> }
  @if (isCatalog) { <script src="~/js/catalog-search.js" asp-append-version="true" defer></script> }
  @if (hasProductCards) { <script src="~/js/favorites.js" asp-append-version="true" defer></script> }
</body>
</html>
