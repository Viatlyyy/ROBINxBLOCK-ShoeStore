@model CartPageViewModel
@{
    ViewData["Title"] = "Корзина";
    var total = Model.Lines.Sum(line => line.Total);
    var count = Model.Lines.Sum(line => line.Quantity);
    var itemsLabel = CartPageViewModel.ItemsLabel(count);
}

<section id="purchase-content" class="purchase-flow cart-page" data-purchase-flow aria-labelledby="cart-title">
  <nav class="purchase-breadcrumb" aria-label="Хлебные крошки">
    <a asp-controller="Home" asp-action="Index">Главная</a><span aria-hidden="true">/</span>
    <span aria-current="page">Корзина</span>
  </nav>
  <header class="purchase-heading">
    <h1 id="cart-title">Корзина</h1>
    <p data-cart-items-label hidden="@(count == 0)">@itemsLabel в корзине</p>
  </header>

  <div class="purchase-notice" role="status" data-cart-notice>@TempData["Message"]</div>
  <div class="purchase-notice purchase-notice--error" role="alert" data-cart-error hidden>
    <span data-cart-error-message></span>
    <a asp-action="Index">Обновить корзину</a>
  </div>

  <div class="cart-empty" data-cart-empty hidden="@(count > 0)">
    <div class="cart-empty__icon"><partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"cart"' /></div>
    <h2 tabindex="-1">Корзина пока пуста</h2>
    <p>Добавьте понравившуюся пару из каталога.</p>
    <a class="button purchase-button" asp-controller="Catalog" asp-action="Index">
      Перейти в каталог <partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"arrow"' />
    </a>
  </div>

  <div class="purchase-columns cart-reference-layout" data-cart-content hidden="@(count == 0)">
    <div class="cart-reference-lines">
      <div class="cart-reference-items" data-cart-lines>
        @foreach (var line in Model.Lines)
        {
          var atLimit = line.Quantity >= line.MaximumQuantity;
          var image = string.IsNullOrWhiteSpace(line.Variant.ImageUrl) ? line.Product.ImageUrl : line.Variant.ImageUrl;
          var name = $"{line.Product.Brand.Name} {line.Product.Name}";
          <article class="cart-reference-item" data-cart-key="@line.Variant.Id:@line.Size" data-cart-name="@name" data-cart-line>
            <a class="purchase-photo cart-reference-item__image" asp-controller="Catalog" asp-action="Details"
               asp-route-id="@line.Product.Id" asp-route-variantId="@line.Variant.Id" aria-label="Открыть @name">
              <span class="purchase-photo__fallback" aria-hidden="true">Нет фото</span>
              @if (!string.IsNullOrWhiteSpace(image))
              {
                <img src="@image" alt="" data-product-photo="compact" data-purchase-photo decoding="async" />
              }
            </a>
            <div class="cart-reference-item__details">
              <h2><a asp-controller="Catalog" asp-action="Details" asp-route-id="@line.Product.Id" asp-route-variantId="@line.Variant.Id">@name</a></h2>
              <p>Цвет: @line.Variant.Name</p>
              <p class="cart-reference-item__size">Размер: @line.Size EU</p>
            </div>
            <form class="cart-reference-item__quantity" asp-action="ChangeQuantity" method="post"
                  aria-label="Количество для @name, @line.Size EU" data-cart-quantity-form>
              <input type="hidden" name="variantId" value="@line.Variant.Id" />
              <input type="hidden" name="size" value="@line.Size" />
              <button type="submit" name="change" value="-1" aria-label="Уменьшить количество" disabled="@(line.Quantity <= 1)">−</button>
              <span data-cart-line-quantity>@line.Quantity</span>
              <button type="submit" name="change" value="1" aria-label="Увеличить количество" disabled="@atLimit">+</button>
            </form>
            <strong class="cart-reference-item__price" data-cart-line-total>@line.Total.ToString("N0") ₽</strong>
            <form class="cart-reference-item__remove" asp-action="Remove" method="post" data-cart-remove-form>
              <input type="hidden" name="variantId" value="@line.Variant.Id" />
              <input type="hidden" name="size" value="@line.Size" />
              <button type="submit" aria-label="Удалить @name, @line.Size EU">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                  <path d="m6 6 12 12M18 6 6 18" />
                </svg>
              </button>
            </form>
          </article>
        }
      </div>
      <a class="purchase-back" asp-controller="Catalog" asp-action="Index">
        <partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"back"' /> Продолжить покупки
      </a>
    </div>

    <aside class="purchase-summary cart-order-card" aria-labelledby="cart-summary-title">
      <h2 id="cart-summary-title">Сводка заказа</h2>
      <dl class="purchase-totals">
        <div><dt>Товары (<span data-cart-summary-count>@count</span>)</dt><dd data-cart-subtotal>@total.ToString("N0") ₽</dd></div>
        <div><dt>Доставка</dt><dd>Стоимость не рассчитана</dd></div>
        <div class="purchase-totals__total"><dt>Итого за товары</dt><dd data-cart-total>@total.ToString("N0") ₽</dd></div>
      </dl>
      <a class="button purchase-button cart-order-card__checkout" asp-action="Checkout" data-cart-checkout>
        Оформить заказ <partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"arrow"' />
      </a>
      @if (User.Identity?.IsAuthenticated != true)
      {
        <p class="cart-order-card__login-note">Войдите, чтобы оформить заказ. Корзина сохранится.</p>
      }
    </aside>
  </div>
  <p class="sr-only" role="status" data-cart-announcement></p>
</section>
