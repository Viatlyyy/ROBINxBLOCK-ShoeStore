@model ShoeStore.Models.CheckoutViewModel
@{ ViewData["Title"] = "Оформление заказа"; }

<section class="checkout-page">
  <p class="checkout-breadcrumb"><a asp-action="Index">Корзина</a><span>/</span> Оформление заказа</p>
  <h1>Оформление заказа</h1>

  <form asp-action="Checkout" method="post" class="checkout-reference" data-checkout-form>
    <input type="hidden" name="confirmation" value="@ViewData["Confirmation"]" />
    <div class="checkout-reference__forms">
      <section class="checkout-panel" data-checkout-panel>
        <h2>Контактные данные</h2>
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="checkout-grid checkout-grid--contact">
          <label>Имя<input asp-for="CustomerName" placeholder="Введите имя" autocomplete="given-name" /><span asp-validation-for="CustomerName"></span></label>
          <label>Фамилия<input asp-for="LastName" placeholder="Введите фамилию" autocomplete="family-name" /><span asp-validation-for="LastName"></span></label>
          <label>E-mail<input asp-for="Email" type="email" placeholder="example@email.com" autocomplete="email" /><span asp-validation-for="Email"></span></label>
          <label>Телефон<input asp-for="Phone" placeholder="+7 (___) ___-__-__" autocomplete="tel" /><span asp-validation-for="Phone"></span></label>
        </div>
      </section>

      <section class="checkout-panel" data-checkout-panel>
        <h2>Доставка</h2>
        <div class="delivery-options" role="radiogroup" aria-label="Способ доставки">
          <label class="delivery-option"><input asp-for="DeliveryMethod" type="radio" id="DeliveryMethod-courier" value="Курьер" /><span><i>●</i>Курьер</span></label>
          <label class="delivery-option"><input asp-for="DeliveryMethod" type="radio" id="DeliveryMethod-pickup" value="Самовывоз" /><span><i>○</i>Самовывоз</span></label>
          <label class="delivery-option"><input asp-for="DeliveryMethod" type="radio" id="DeliveryMethod-collection" value="Пункт выдачи" /><span><i>○</i>Пункт выдачи</span></label>
        </div>
        <div class="checkout-grid checkout-grid--address">
          <label>Город<select asp-for="City"><option value="">Выберите город</option><option>Москва</option><option>Санкт-Петербург</option><option>Казань</option></select><span asp-validation-for="City"></span></label>
          <label class="checkout-grid__wide">Улица<input asp-for="Street" placeholder="Введите улицу" autocomplete="street-address" /><span asp-validation-for="Street"></span></label>
          <label>Дом<input asp-for="House" placeholder="Введите дом" /><span asp-validation-for="House"></span></label>
          <label>Квартира<input asp-for="Apartment" placeholder="Введите квартиру" /><span asp-validation-for="Apartment"></span></label>
          <label>Индекс<input asp-for="Postcode" placeholder="Введите индекс" autocomplete="postal-code" /><span asp-validation-for="Postcode"></span></label>
        </div>
        <p class="checkout-delivery-note">⌁ Стандартная доставка 1–3 дня</p>
      </section>

      <section class="checkout-panel" data-checkout-panel>
        <h2>Способ оплаты</h2>
        <div class="payment-options">
          <label class="payment-option"><input asp-for="PaymentMethod" type="radio" id="PaymentMethod-cash" value="cash" checked /><span><i>●</i>Оплата при получении</span></label>
        </div>
      </section>

      <section class="checkout-panel checkout-panel--comment" data-checkout-panel>
        <label>Комментарий к заказу <small>(необязательно)</small><textarea asp-for="Comment" placeholder="Ваш комментарий к заказу"></textarea><span asp-validation-for="Comment"></span></label>
      </section>
    </div>

    <aside class="checkout-summary" data-checkout-summary>
      <h2>Ваш заказ</h2>
      <div class="checkout-summary__items">
        @foreach (var line in Model.Lines)
        {
          <article class="checkout-summary__item">
            <img src="@(string.IsNullOrWhiteSpace(line.Variant.ImageUrl) ? line.Product.ImageUrl : line.Variant.ImageUrl)" alt="@line.Product.Brand.Name @line.Product.Name" data-product-photo="compact" loading="lazy" decoding="async" />
            <div><b>@line.Product.Brand.Name</b><strong>@line.Product.Name</strong><span>Цвет: @line.Variant.Name</span><span>Размер: @line.Size EU</span></div>
            <em>@line.Quantity × @line.Product.Price.ToString("N0") ₽</em><i>@line.Total.ToString("N0") ₽</i>
          </article>
        }
      </div>
      <dl>
        <div><dt>Подытог</dt><dd>@Model.Total.ToString("N0") ₽</dd></div>
        <div><dt>Доставка</dt><dd>Бесплатно</dd></div>
        <div><dt>Скидка</dt><dd>0 ₽</dd></div>
        <div class="checkout-summary__total"><dt>Итого</dt><dd>@Model.Total.ToString("N0") ₽</dd></div>
      </dl>
      <label class="checkout-promo"><input placeholder="Введите промокод" /><button type="button" aria-label="Применить промокод">→</button></label>
      <button class="button checkout-submit" type="submit">Подтвердить заказ</button>
      <a class="checkout-back" asp-action="Index">Вернуться в корзину</a>
      <p class="checkout-security">♧&nbsp;&nbsp; Безопасная оплата и защита данных</p>
    </aside>
  </form>
</section>

<section class="checkout-benefits" aria-label="Преимущества RONINxBLOCK">
  <div><span>▱</span><p><b>Бесплатная доставка</b><small>По всей России</small></p></div>
  <div><span>▣</span><p><b>Безопасная оплата</b><small>Мы защищаем ваши данные</small></p></div>
  <div><span>◇</span><p><b>Лёгкий возврат</b><small>14 дней на возврат</small></p></div>
  <div><span>☆</span><p><b>Поддержка 24/7</b><small>Мы всегда на связи</small></p></div>
</section>
