@model ShoeStore.Models.AccountOrdersViewModel
@{
  Layout = "_CabinetLayout";
  ViewData["Title"] = "Мои заказы";
}
@if (Model.Orders.Count == 0)
{
  <partial name="_EmptyState" model='(("orders", "Пока нет заказов.", "После покупки здесь появятся товары, суммы и статусы ваших заказов."))' />
}
else
{
  <ul class="account-orders account-orders--history">
    @foreach (var order in Model.Orders) { <partial name="_OrderRow" model="order" /> }
  </ul>
  @if (Model.TotalPages > 1)
  {
    <nav class="account-pagination" aria-label="Страницы заказов">
      @if (Model.Page > 1)
      {
        <a class="account-action" asp-action="Orders" asp-route-page="@(Model.Page - 1)"><partial name="_AccountIcon" model='"back"' /> Назад</a>
      }
      <span>Страница @Model.Page из @Model.TotalPages</span>
      @if (Model.Page < Model.TotalPages)
      {
        <a class="account-action" asp-action="Orders" asp-route-page="@(Model.Page + 1)">Далее <partial name="_AccountIcon" model='"arrow"' /></a>
      }
    </nav>
  }
}
