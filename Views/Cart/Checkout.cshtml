@model CheckoutViewModel
@{
    ViewData["Title"] = "Оформление заказа";
}

<section id="purchase-content" class="purchase-flow checkout-page" data-purchase-flow aria-labelledby="checkout-title">
  <div class="checkout-page__heading">
    <nav class="purchase-breadcrumb" aria-label="Хлебные крошки">
      <a asp-controller="Home" asp-action="Index">Главная</a><span aria-hidden="true">/</span>
      <a asp-action="Index">Корзина</a><span aria-hidden="true">/</span>
      <span aria-current="page">Оформление заказа</span>
    </nav>
    <header class="purchase-heading"><h1 id="checkout-title">Оформление заказа</h1></header>
  </div>

  <div class="checkout-stage">
    <form asp-action="Checkout" method="post" class="purchase-columns checkout-reference" data-checkout-form>
      <input type="hidden" name="confirmation" value="@ViewData["Confirmation"]" />
      <div class="checkout-reference__forms">
        <div asp-validation-summary="ModelOnly" class="checkout-errors" role="alert" tabindex="-1" data-checkout-errors></div>

        <section class="checkout-panel" aria-labelledby="checkout-contact">
          <h2 class="checkout-panel__title" id="checkout-contact">
            <span class="checkout-panel__icon"><partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"profile"' /></span>
            Контактные данные
          </h2>
          <div class="checkout-grid checkout-grid--contact">
            <label class="checkout-field">
              Имя <span aria-hidden="true">*</span>
              <span class="checkout-field__control">
                <partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"profile"' />
                <input asp-for="CustomerName" placeholder="Введите имя" autocomplete="given-name" maxlength="80" required aria-describedby="checkout-name-error" />
              </span>
              <span asp-validation-for="CustomerName" id="checkout-name-error"></span>
            </label>
            <label class="checkout-field">
              Фамилия
              <span class="checkout-field__control">
                <partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"profile"' />
                <input asp-for="LastName" placeholder="Введите фамилию" autocomplete="family-name" maxlength="80" aria-describedby="checkout-last-name-error" />
              </span>
              <span asp-validation-for="LastName" id="checkout-last-name-error"></span>
            </label>
            <label class="checkout-field">
              E-mail
              <span class="checkout-field__control">
                <partial name="_CheckoutIcon" model='"mail"' />
                <input asp-for="Email" type="email" placeholder="Введите e-mail" autocomplete="email" maxlength="254" aria-describedby="checkout-email-error" />
              </span>
              <span asp-validation-for="Email" id="checkout-email-error"></span>
            </label>
            <label class="checkout-field">
              Телефон <span aria-hidden="true">*</span>
              <span class="checkout-field__control">
                <partial name="_CheckoutIcon" model='"phone"' />
                <input asp-for="Phone" type="tel" placeholder="+7 (___) ___-__-__" autocomplete="tel" maxlength="32" required aria-describedby="checkout-phone-error" />
              </span>
              <span asp-validation-for="Phone" id="checkout-phone-error"></span>
            </label>
          </div>
        </section>

        <section class="checkout-panel checkout-delivery" aria-labelledby="checkout-delivery">
          <h2 class="checkout-panel__title" id="checkout-delivery">
            <span class="checkout-panel__icon"><partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"truck"' /></span>
            Доставка
          </h2>
          <fieldset class="checkout-delivery__options">
            <legend class="sr-only">Способ доставки</legend>
            <div class="delivery-options">
              @foreach (var (id, label) in new[] { ("courier", "Курьер"), ("pickup", "Самовывоз"), ("collection", "Пункт выдачи") })
              {
                <label class="delivery-option">
                  <input asp-for="DeliveryMethod" type="radio" id="DeliveryMethod-@id" value="@label" data-delivery-option="@id" aria-describedby="checkout-delivery-error" />
                  <span>@label</span>
                </label>
              }
            </div>
            <span asp-validation-for="DeliveryMethod" id="checkout-delivery-error"></span>
          </fieldset>

          <div class="checkout-address" data-delivery-fields>
            <div class="checkout-address__city" data-delivery-city>
              <label class="checkout-field">
                Город <span aria-hidden="true">*</span>
                <span class="checkout-field__control">
                  <partial name="_CheckoutIcon" model='"pin"' />
                  <select asp-for="City" autocomplete="address-level2" aria-describedby="checkout-city-error"
                          data-checkout-required-message="Выберите город.">
                    <option value="">Выберите город</option>
                    <option>Москва</option>
                    <option>Санкт-Петербург</option>
                    <option>Казань</option>
                    <option>Новороссийск</option>
                  </select>
                  <partial name="_CheckoutIcon" model='"chevron"' />
                </span>
                <span asp-validation-for="City" id="checkout-city-error"></span>
              </label>
            </div>
            <div class="checkout-address__courier" data-delivery-address>
              <label class="checkout-field checkout-address__street">
                Улица <span aria-hidden="true">*</span>
                <span class="checkout-field__control">
                  <partial name="_CheckoutIcon" model='"road"' />
                  <input asp-for="Street" placeholder="Введите улицу" autocomplete="address-line1" maxlength="120"
                         aria-describedby="checkout-street-error" data-checkout-required-message="Введите улицу." />
                </span>
                <span asp-validation-for="Street" id="checkout-street-error"></span>
              </label>
              <label class="checkout-field">
                Дом <span aria-hidden="true">*</span>
                <span class="checkout-field__control">
                  <partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"home"' />
                  <input asp-for="House" placeholder="Введите дом" maxlength="20"
                         aria-describedby="checkout-house-error" data-checkout-required-message="Введите номер дома." />
                </span>
                <span asp-validation-for="House" id="checkout-house-error"></span>
              </label>
              <label class="checkout-field">
                Квартира
                <span class="checkout-field__control">
                  <partial name="_CheckoutIcon" model='"building"' />
                  <input asp-for="Apartment" placeholder="Введите квартиру" autocomplete="address-line2" maxlength="20" aria-describedby="checkout-apartment-error" />
                </span>
                <span asp-validation-for="Apartment" id="checkout-apartment-error"></span>
              </label>
              <label class="checkout-field">
                Индекс
                <span class="checkout-field__control">
                  <partial name="_CheckoutIcon" model='"mail"' />
                  <input asp-for="Postcode" placeholder="Введите индекс" autocomplete="postal-code" inputmode="numeric" maxlength="12" aria-describedby="checkout-postcode-error" />
                </span>
                <span asp-validation-for="Postcode" id="checkout-postcode-error"></span>
              </label>
            </div>
          </div>
        </section>

        <section class="checkout-panel" aria-labelledby="checkout-payment">
          <h2 class="checkout-panel__title" id="checkout-payment">
            <span class="checkout-panel__icon"><partial name="_CheckoutIcon" model='"card"' /></span>
            Способ оплаты
          </h2>
          <input type="hidden" name="PaymentMethod" value="cash" />
          <div class="checkout-payment"><span aria-hidden="true"></span>Оплата при получении</div>
          <span asp-validation-for="PaymentMethod"></span>
        </section>

        <section class="checkout-panel" aria-labelledby="checkout-comment">
          <h2 class="checkout-panel__title" id="checkout-comment">
            <span class="checkout-panel__icon"><partial name="_CheckoutIcon" model='"message"' /></span>
            <label for="Comment">Комментарий к заказу</label>
          </h2>
          <div class="checkout-field__control checkout-field__control--comment">
            <partial name="_CheckoutIcon" model='"message"' />
            <textarea asp-for="Comment" placeholder="Введите комментарий к заказу" maxlength="500" rows="1" aria-describedby="checkout-comment-error"></textarea>
          </div>
          <span asp-validation-for="Comment" id="checkout-comment-error"></span>
        </section>
      </div>

      <aside class="purchase-summary checkout-summary" aria-labelledby="checkout-summary-title">
        <h2 id="checkout-summary-title">Ваш заказ</h2>
        <ul class="checkout-summary__items">
          @foreach (var line in Model.Lines)
          {
            var image = string.IsNullOrWhiteSpace(line.Variant.ImageUrl) ? line.Product.ImageUrl : line.Variant.ImageUrl;
            <li class="checkout-summary__item">
              <div class="purchase-photo checkout-summary__photo">
                <span class="purchase-photo__fallback" aria-hidden="true">Нет фото</span>
                @if (!string.IsNullOrWhiteSpace(image))
                {
                  <img src="@image" alt="" data-product-photo="compact" data-purchase-photo decoding="async" />
                }
              </div>
              <div class="checkout-summary__item-info">
                <span class="purchase-product-brand">@line.Product.Brand.Name</span>
                <strong>@line.Product.Name</strong>
                <span>@line.Variant.Name</span>
                <span>Размер: @line.Size EU</span>
              </div>
              <div class="checkout-summary__cost">
                <strong>@line.Total.ToString("N0") ₽</strong>
                @if (line.Quantity > 1)
                {
                  <small>@line.Quantity × @line.Product.Price.ToString("N0") ₽</small>
                }
              </div>
            </li>
          }
        </ul>
        <dl class="purchase-totals">
          <div><dt>Подытог</dt><dd>@Model.Total.ToString("N0") ₽</dd></div>
          <div><dt>Доставка</dt><dd>Не рассчитана</dd></div>
          <div class="purchase-totals__total"><dt>Итого за товары</dt><dd>@Model.Total.ToString("N0") ₽</dd></div>
        </dl>
        <button class="button purchase-button checkout-submit" type="submit" disabled="@(Model.Lines.Count == 0)">
          <span data-checkout-submit-label>Подтвердить заказ</span>
          <partial name="~/Views/Cabinet/_AccountIcon.cshtml" model='"arrow"' />
          <span class="checkout-spinner" aria-hidden="true" hidden></span>
        </button>
        <a class="purchase-back checkout-back" asp-action="Index">Вернуться к корзине</a>
        <p class="sr-only" role="status" data-checkout-progress></p>
      </aside>
    </form>
  </div>
</section>
