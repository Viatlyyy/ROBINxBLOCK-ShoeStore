@model ShoeStore.Models.CartPageViewModel
@{
    ViewData["Title"] = "Корзина";
    var total = Model.Lines.Sum(x => x.Total);
    var count = Model.Lines.Sum(x => x.Quantity);
}

<section class="cart-page">
  <header class="cart-page__heading">
    <h1>Корзина</h1>
    <p data-cart-items-label>@CartPageViewModel.ItemsLabel(count)</p>
  </header>

  @if (TempData["Message"] is not null)
  {
    <div class="notice">@TempData["Message"]</div>
  }

  @if (!Model.Lines.Any())
  {
    <div class="cart-empty"><h2>Корзина пока пуста</h2><a class="button" asp-controller="Home" asp-action="Index" asp-fragment="catalog">Перейти в каталог</a></div>
  }
  else
  {
    <div class="cart-reference-layout">
      <div class="cart-reference-lines">
        @foreach (var line in Model.Lines)
        {
          <article class="cart-reference-item" data-cart-line>
            <a class="cart-reference-item__image" asp-controller="Catalog" asp-action="Details" asp-route-id="@line.Product.Id" asp-route-variantId="@line.Variant.Id" aria-label="Открыть @line.Product.Brand.Name @line.Product.Name">
              @{ var image = string.IsNullOrWhiteSpace(line.Variant.ImageUrl) ? line.Product.ImageUrl : line.Variant.ImageUrl; }
              @if (string.IsNullOrWhiteSpace(image))
              {
                <span class="product-image-empty">Нет фотографии</span>
              }
              else
              {
                <img src="@image" alt="@line.Product.Brand.Name @line.Product.Name" decoding="async" />
              }
            </a>
            <div class="cart-reference-item__details">
              <p class="cart-reference-item__brand">@line.Product.Brand.Name</p>
              <h2>@line.Product.Name</h2>
              <p>Цвет: @line.Variant.Name</p>
              <p>Размер: @line.Size</p>
            </div>
            <form class="cart-reference-item__remove" asp-action="Remove" method="post">
              <input type="hidden" name="variantId" value="@line.Variant.Id" />
              <input type="hidden" name="size" value="@line.Size" />
              <button type="submit" aria-label="Удалить @line.Product.Brand.Name @line.Product.Name">×</button>
            </form>
            <form class="cart-reference-item__quantity" asp-action="ChangeQuantity" method="post" aria-label="Количество @line.Product.Name" data-cart-quantity-form>
              <input type="hidden" name="variantId" value="@line.Variant.Id" />
              <input type="hidden" name="size" value="@line.Size" />
              <button type="submit" name="change" value="-1" aria-label="Уменьшить количество">−</button><span data-cart-line-quantity>@line.Quantity</span><button type="submit" name="change" value="1" aria-label="Увеличить количество">+</button>
            </form>
            <strong class="cart-reference-item__price" data-cart-line-total>@line.Total.ToString("N0") ₽</strong>
          </article>
        }
      </div>

      <aside class="cart-order-card">
        <h2>Ваш заказ</h2>
        <label class="cart-promo"><span>Промокод</span><div><input type="text" placeholder="Введите промокод" disabled /><button type="button" aria-label="Применить промокод" disabled>→</button></div></label>
        <dl>
          <div><dt>Подытог</dt><dd data-cart-subtotal>@total.ToString("N0") ₽</dd></div>
          <div><dt>Доставка</dt><dd>Бесплатно</dd></div>
          <small>Стандартная доставка 1–3 дня</small>
          <div class="cart-order-card__total"><dt>Итого</dt><dd data-cart-total>@total.ToString("N0") ₽</dd></div>
        </dl>
        <a class="button cart-order-card__checkout" asp-action="Checkout">Оформить заказ</a>
        @if (User.Identity?.IsAuthenticated != true)
        {
          <p class="cart-order-card__login-note">Войдите, чтобы оформить заказ. Корзина сохранится.</p>
        }
        <a class="cart-order-card__continue" asp-controller="Home" asp-action="Index" asp-fragment="catalog">Продолжить покупки</a>
      </aside>
    </div>
  }
</section>

@if (Model.Recommendations.Any())
{
  <section class="cart-recommendations">
    <div class="cart-recommendations__heading"><h2>С этим покупают</h2><a asp-controller="Home" asp-action="Index" asp-fragment="catalog">Смотреть все <span>→</span></a></div>
    <div class="cart-recommendations__grid">@foreach (var product in Model.Recommendations) { <partial name="_ProductCard" model="product" /> }</div>
  </section>
}

<section class="cart-benefits" aria-label="Преимущества RONINxBLOCK">
  <div><span>▱</span><p><b>Бесплатная доставка</b><small>По всей России</small></p></div>
  <div><span>▣</span><p><b>Безопасная оплата</b><small>Мы защищаем ваши данные</small></p></div>
  <div><span>◇</span><p><b>Лёгкий возврат</b><small>14 дней на возврат</small></p></div>
  <div><span>☆</span><p><b>Поддержка 24/7</b><small>Мы всегда на связи</small></p></div>
</section>
