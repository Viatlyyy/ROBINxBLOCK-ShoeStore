@model IReadOnlyList<ShoeStore.Models.ProductCardViewModel>
@{
  Layout = "_CabinetLayout";
  ViewData["Title"] = "Избранное";
  ViewData["FavoriteCount"] = Model.Count;
  ViewData["HideEmptyState"] = Model.Count > 0;
}
<div class="account-product-grid" data-favorites-list hidden="@(Model.Count == 0)">
  @foreach (var product in Model)
  {
    <partial name="_FavoriteProduct" model="product" />
  }
</div>
<partial name="_EmptyState" model='(("heart", "Пока нет избранных товаров.", "Нажмите на сердце в каталоге, чтобы сохранить понравившуюся модель."))' />
