<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- MSTest запускает проверки, Moq подменяет менеджеры Identity без подключения к PostgreSQL. -->
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Модели берём из библиотеки, настоящий контроллер — из приложения. Копий проверяемого кода здесь нет. -->
    <ProjectReference Include="../ShoeStore.Library/ShoeStore.Library.csproj" />
    <ProjectReference Include="../ShoeStore.csproj" />
  </ItemGroup>

</Project>
