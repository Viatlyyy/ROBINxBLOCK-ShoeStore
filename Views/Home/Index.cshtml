@model ShoeStore.Models.HomePageViewModel
@{
  ViewData["Title"] = "RONINxBLOCK";
  var slides = new[]
  {
    (Brand: "New Balance", Name: "9060", Color: "Sea Salt", Scene: "9060-urban-feet-v6", Pair: "9060-urban-pair-v6", Action: "Hits"),
    (Brand: "Balenciaga", Name: "3XL", Color: "White / Grey", Scene: "3xl-urban-feet-v5", Pair: "3xl-urban-pair-v5", Action: "New"),
    (Brand: "Nike", Name: "Dunk Low", Color: "Panda", Scene: "dunk-urban-feet-v6", Pair: "dunk-urban-pair-v6", Action: "New")
  };
  var brands = Model.Brands;
}

<section class="hero-carousel" aria-label="Популярные модели">
  @for (var i = 0; i < slides.Length; i++)
  {
    var slide = slides[i];
    var onFeet = "/images/hero/" + slide.Scene;
    var pair = "/images/hero/" + slide.Pair;

    <article class="hero-slide @(i == 0 ? "is-active" : "")">
      <div class="hero-media" aria-hidden="true">
        @if (i == 0) { <img class="hero-scene hero-scene--feet" src="@(onFeet + "-960.webp")" srcset="@(onFeet + "-960.webp 960w, " + onFeet + "-1600.webp 1600w")" sizes="100vw" alt="" decoding="async" fetchpriority="high" /> }
        else { <img class="hero-scene hero-scene--feet" data-src="@(onFeet + "-960.webp")" data-srcset="@(onFeet + "-960.webp 960w, " + onFeet + "-1600.webp 1600w")" sizes="100vw" alt="" decoding="async" fetchpriority="low" /> }
        <img class="hero-scene hero-scene--pair" data-src="@(pair + "-960.webp")" data-srcset="@(pair + "-960.webp 960w, " + pair + "-1600.webp 1600w")" sizes="100vw" alt="" decoding="async" fetchpriority="low" />
      </div>
      <div class="hero-copy">
        <p class="eyebrow">RONINxBLOCK / НОВЫЙ СЕЗОН</p>
        <h1>@slide.Brand<br />@slide.Name</h1>
        <p>@slide.Color. Культовая модель для города, комфортная посадка и выразительный силуэт.</p>
        <a class="button" asp-controller="Catalog" asp-action="@slide.Action">Смотреть подборку <span>→</span></a>
        <div class="hero-note"><b>10 000+</b><span>покупателей<br />выбирают RONINxBLOCK</span></div>
      </div>
      <div class="hero-model"><b>@slide.Brand<br />@slide.Name</b><span>@slide.Color</span></div>
    </article>
  }

  <div class="hero-controls">
    <button class="hero-arrow" type="button" data-hero-prev aria-label="Предыдущая модель">←</button>
    <div class="hero-dots" aria-hidden="true">
      @for (var i = 0; i < slides.Length; i++)
      {
        <span class="hero-dot @(i == 0 ? "is-active" : "")" data-hero-dot="@i"></span>
      }
    </div>
    <button class="hero-arrow" type="button" data-hero-next aria-label="Следующая модель">→</button>
  </div>
  <div class="hero-progress" aria-label="Индикатор автоматической смены модели"><span></span></div>
</section>

<section class="content home-catalog" id="catalog" aria-labelledby="catalog-title">
  <div class="section-title">
    <h2 id="catalog-title">Каталог</h2>
  </div>
  <partial name="_CatalogPlaceholders" />
</section>

<section class="content edit-grid feature-grid home-promotions">
  <article class="feature-tile feature-tile--triple" data-reveal>
    <img class="feature-tile__advertisement" src="/images/advertising/triple-s.jpg" alt="Balenciaga Triple S" loading="lazy" decoding="async" />
    <div><p class="eyebrow">BALENCIAGA</p><h2>Triple S</h2><a class="button" asp-controller="Catalog" asp-action="New">Смотреть <span>→</span></a></div>
  </article>
  <article class="feature-tile feature-tile--collection" data-reveal>
    <img src="/images/features/new-collection-hoodie-640.webp" srcset="/images/features/new-collection-hoodie-640.webp 640w, /images/features/new-collection-hoodie-1200.webp 1200w" sizes="(max-width:760px) 100vw, 50vw" alt="Новая коллекция" loading="lazy" decoding="async" />
    <div><p class="eyebrow">НОВАЯ КОЛЛЕКЦИЯ</p><h2>Весна / Лето<br />2026</h2><a class="button" asp-controller="Catalog" asp-action="New">Смотреть <span>→</span></a></div>
  </article>
</section>

<section class="brand-ticker is-paused" aria-label="Бренды">
  <div class="brand-ticker__track">
    @for (var copy = 0; copy < 6; copy++)
    {
      <div class="brand-ticker__group" aria-hidden="@(copy > 0 ? "true" : null)">
        @foreach (var brand in brands)
        {
          <span class="brand-ticker__link brand-ticker__link--@brand.ToLower().Replace(" ", "-")">
            <partial name="_BrandTickerMark" model="brand" />
          </span>
        }
      </div>
    }
  </div>
</section>

<section class="content culture-board" aria-label="RONINxBLOCK и культура кроссовок">
  <a class="culture-board__image" asp-controller="Catalog" asp-action="Index" data-reveal>
    <img src="/images/culture/street-walk-640.webp" srcset="/images/culture/street-walk-640.webp 640w, /images/culture/street-walk-1200.webp 1200w" sizes="(max-width:760px) 100vw, 50vw" alt="Уличный стиль и кроссовки" loading="lazy" decoding="async" />
  </a>
  <article class="culture-board__story" data-reveal>
    <p class="eyebrow">RONINxBLOCK JOURNAL</p>
    <h2>Культура<br />движется вперёд.</h2>
    <p>Кроссовки — это движение, характер и сообщество. Мы собираем модели, которые остаются актуальными каждый день.</p>
    <a asp-controller="Home" asp-action="Index" asp-fragment="catalog">Все модели <span>→</span></a>
  </article>
  <a class="culture-board__community" asp-controller="Catalog" asp-action="Index" data-reveal>
    <img src="/images/culture/city-community-640.webp" srcset="/images/culture/city-community-640.webp 640w, /images/culture/city-community-1200.webp 1200w" sizes="(max-width:760px) 100vw, 34vw" alt="Городское сообщество RONINxBLOCK" loading="lazy" decoding="async" />
    <span><b>RONINxBLOCK<br />СООБЩЕСТВО</b><small>Люди. Город. Пары.<br />Выбери свой стиль.</small><i>→</i></span>
  </a>
  <div class="culture-board__stack" data-reveal>
    <a asp-controller="Catalog" asp-action="Index"><img src="/images/culture/stair-sneakers-640.webp" srcset="/images/culture/stair-sneakers-640.webp 640w, /images/culture/stair-sneakers-1200.webp 1200w" sizes="(max-width:760px) 100vw, 34vw" alt="Кроссовки на городской лестнице" loading="lazy" decoding="async" /></a>
    <a asp-controller="Catalog" asp-action="Index"><img src="/images/culture/street-portrait-640.webp" srcset="/images/culture/street-portrait-640.webp 640w, /images/culture/street-portrait-1200.webp 1200w" sizes="(max-width:760px) 100vw, 34vw" alt="Уличный образ новой коллекции" loading="lazy" decoding="async" /></a>
  </div>
</section>

