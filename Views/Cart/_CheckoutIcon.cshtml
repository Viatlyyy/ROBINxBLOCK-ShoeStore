  {
    case "mail":
      <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 7 8.5 6 8.5-6" />
      break;
    case "phone":
      <path d="M22 17.2v2.7a2 2 0 0 1-2.2 2 18 18 0 0 1-7.8-2.8 18 18 0 0 1-5.5-5.5 18 18 0 0 1-2.8-7.9A2 2 0 0 1 5.7 3h2.7a2 2 0 0 1 2 1.7l.5 2.6a2 2 0 0 1-.5 2.1L9.3 10.5a14 14 0 0 0 4.2 4.2l1.1-1.1a2 2 0 0 1 2.1-.5l2.6.5a2 2 0 0 1 2.7 1.6z" transform="translate(-1 0)" />
      break;
    case "pin":
      <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.3" />
      break;
    case "road":
      <path d="M8 4h8l5 16H3zM12 4v3m0 3v3m0 3v4" />
      break;
    case "building":
      <path d="M4 21V3h10v18m0-14h6v14H4m3-14h.1m3.9 0h.1M7 11h.1m3.9 0h.1M7 15h.1m3.9 0h.1M17 11h.1m-.1 4h.1" />
      break;
    case "card":
      <rect x="2" y="4" width="20" height="16" rx="2" /><path d="M2 9h20M6 15h3" />
      break;
    case "message":
      <path d="M5 4h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-1-2V6a2 2 0 0 1 2-2Z M8 10h8" />
      break;
    case "chevron":
      <path d="m6 9 6 6 6-6" />
      break;
  }
</svg>
