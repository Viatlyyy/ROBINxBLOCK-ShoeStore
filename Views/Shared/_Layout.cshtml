<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] — RONINxBLOCK</title>
  <link rel="preload" href="~/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/account-reference.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/page-intro.css" asp-append-version="true" />
</head>
<body class="is-page-entering">
  <header class="header">
    <a class="logo" asp-controller="Account" asp-action="Register">RONIN<span>xBLOCK</span></a>
  </header>
  <main>@RenderBody()</main>
  <script src="~/js/account-form.js" asp-append-version="true"></script>
  <script src="~/js/page-intro.js" asp-append-version="true"></script>
</body>
</html>
